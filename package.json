{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "train-times",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "pnpm lint:check && pnpm typecheck",
		"commit": "cz",
		"commitlint": "commitlint --edit",
		"dev": "portless --lan",
		"dev:app": "next dev",
		"lint:check": "ultracite check",
		"lint": "ultracite fix",
		"proxy": "portless proxy start --lan",
		"prepare": "lefthook install",
		"preview": "next build && next start",
		"start": "next start",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@t3-oss/env-nextjs": "^0.13.10",
		"@tanstack/react-query": "^5.90.12",
		"@trpc/client": "^11.8.0",
		"@trpc/react-query": "^11.8.0",
		"@trpc/server": "^11.8.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"env.style": "1.0.1",
		"framer-motion": "^12.23.26",
		"geist": "^1.5.1",
		"lucide-react": "^0.561.0",
		"next": "^16.2.10",
		"next-themes": "^0.4.6",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.68.0",
		"react-select": "5.10.2",
		"react-window": "^2.2.3",
		"server-only": "^0.0.1",
		"superjson": "^2.2.6",
		"tailwind-merge": "^2.6.0",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"babel-plugin-react-compiler": "1.0.0",
		"commitizen": "4.3.2",
		"cz-conventional-changelog": "3.3.0",
		"lefthook": "2.1.10",
		"oxfmt": "0.59.0",
		"oxlint": "1.74.0",
		"portless": "0.15.4",
		"postcss": "^8.5.6",
		"tailwindcss": "^3.4.3",
		"typescript": "^5.9.3",
		"ultracite": "7.9.4"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"ct3aMetadata": {
		"initVersion": "7.38.1"
	},
	"portless": {
		"name": "trains",
		"script": "dev:app"
	}
}
